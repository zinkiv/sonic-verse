# Copy to `.env` and adjust as needed.

# Host-published port (mapped to container 7526)
SERVER_PORT=7526

# Optional host bind paths (defaults: ./music ./data)
# MUSIC_DIR=./music
# DATA_DIR=./data

# Database: sqlite (default when empty) | postgresql
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgres://user:password@host:5432/sonic_verse?sslmode=prefer
DATABASE_TYPE=
DATABASE_URL=

# Optional: override version shown in Settings (otherwise uses image-baked git tag)
# APP_VERSION=v0.1.0

DEBUG=false
