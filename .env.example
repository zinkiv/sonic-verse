# Copy to `.env` and adjust as needed.

# Host-published port (mapped to container 7526)
SERVER_PORT=7526

# Optional host bind paths (defaults: ./music ./data)
# MUSIC_DIR=./music
# DATA_DIR=./data

# Database: leave empty for SQLite; set a postgres URL to use PostgreSQL
# DATABASE_URL=postgres://user:password@host:5432/sonic_verse?sslmode=prefer
DATABASE_URL=

# Optional: override version shown in Settings (otherwise uses image-baked git tag)
# APP_VERSION=v0.1.0

# Optional: login token secret (empty → auto file under data/.auth_secret)
# AUTH_SECRET=

# Container process user (match the owner of /music and /data on the NAS)
PUID=1000
PGID=1000

DEBUG=false
